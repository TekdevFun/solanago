{
  "name": "solanago",
  "version": "0.1.0",
  "description": "SolanaGO: a real-world SOL treasure hunt funded by token trading fees",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
